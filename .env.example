# AdSense（審査通過済み前提）。パブリッシャーID（ca-pub-xxxxxxxxxxxxxxxx）を入れると広告配信が始まる
NEXT_PUBLIC_ADSENSE_CLIENT=
# 広告ユニットID（AdSense管理画面でユニットを作成して取得）。未設定の枠は自動で非表示
# 記事下ユニット
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# 記事上部ユニット（タイトル直下）
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
# トップページ中段ユニット
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
# ※自動広告だけ使う場合は CLIENT だけ設定し、AdSense管理画面で自動広告をONにする（ユニットIDは空でよい）

# サイトのURL。独自ドメインに移行したら、ここを新しいURLに変えるだけでcanonical/sitemap等に反映される
NEXT_PUBLIC_SITE_URL=https://nexiary-phi.vercel.app

# Googleアナリティクス4の測定ID（G-XXXXXXXXXX）
# 未設定の間はGA4タグ自体が読み込まれない
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 楽天アフィリエイト（楽天room等で発行した紹介リンク）
# 未設定の間は左下の楽天バッジ（RakutenCorner）は自動的に非表示になる
NEXT_PUBLIC_RAKUTEN_URL=

# 「累計閲覧数」表示（ReadingPulse）用。
# Vercelダッシュボード → Marketplace → Upstash（Redis）を接続すると、
# KV_REST_API_URL / KV_REST_API_TOKEN が自動的に設定される。
# 未設定の間はこの機能自体が自動的に非表示になり、サイトの他の部分には影響しない。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 英語ページ（/en）用：Amazon.com Associates（米国）のトラッキングID。日本のアソシエイトIDとは別アカウントが必要。未設定の間はタグなしリンクになり、成果は発生しない
NEXT_PUBLIC_AMAZON_US_TAG=

# DiffFlow Pro（月額課金）用 PAY.JP。3つすべて未設定の間は決済フォーム自体が出ない（サイトは壊れない）
# PAY.JP管理画面で取得: 公開鍵 / 秘密鍵 / 月額980円で作成した定期課金プランのID
NEXT_PUBLIC_PAYJP_PUBLIC_KEY=
PAYJP_SECRET_KEY=
PAYJP_PRO_PLAN_ID=
